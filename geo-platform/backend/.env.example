DATABASE_URL=sqlite:///./geo_v0.db
WENXIN_API_KEY=
WENXIN_SECRET_KEY=
WENXIN_MODEL=ernie-4.0-turbo-8k

# Semantic Model A (existing)
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Optional Model B critic. Disabled until a bounded critic call is explicitly
# authorized; never put a real key in Git.
MODEL_B_ENABLED=false
MODEL_B_PROVIDER=siliconflow
SILICONFLOW_API_KEY=
SILICONFLOW_MODEL=Qwen/Qwen3.6-35B-A3B
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_TIMEOUT_SECONDS=120
MODEL_B_SHADOW_MAX_CALLS=8
MODEL_B_SHADOW_MAX_TOKENS=100000

MONITORING_ARTIFACT_DIR=./artifacts/monitoring
REDIS_URL=redis://localhost:6379/0
WENXIN_PROFILE_DIR=./runtime/wenxin-profile
WENXIN_WEB_URL=https://chat.baidu.com/
WENXIN_HEADLESS=false
WENXIN_BROWSER_TIMEOUT_SECONDS=180
WENXIN_MAX_CONCURRENCY=1
WENXIN_MAX_RETRIES=2
REFERENCE_RESOLUTION_MIN_RATE=0.95
REFERENCE_TITLE_FUZZY_THRESHOLD=0.72
