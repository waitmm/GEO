{
  "name": "geo-platform-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --mode release",
    "dev:legacy": "vite --mode legacy --port 5174",
    "test:startup": "node --test tests/startup.test.mjs",
    "test:client": "node --experimental-strip-types --test tests/api-client.test.mjs tests/evidence.test.mjs tests/manuscript-export.test.mjs tests/optimization-selection.test.mjs tests/optimization-status.test.mjs tests/project-configuration.test.mjs",
    "build": "tsc && vite build --mode release",
    "build:release": "tsc && vite build --mode release",
    "build:legacy": "tsc && vite build --mode legacy --outDir dist-legacy",
    "preview": "vite preview"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "antd": "^5.22.7",
    "vite": "^6.0.7",
    "typescript": "^5.7.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "lucide-react": "^0.468.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "axe-core": "4.14.0"
  }
}
