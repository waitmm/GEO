<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>com.geo.beta.worker</string>
  <key>ProgramArguments</key><array>
    <string>@@PYTHON_BIN@@</string><string>scripts/release_worker.py</string>
    <string>--interval</string><string>10</string>
  </array>
  <key>WorkingDirectory</key><string>@@BACKEND_DIR@@</string>
  <key>EnvironmentVariables</key><dict>
    <key>GEO_RELEASE_DATABASE_URL</key><string>@@DATABASE_URL@@</string>
    <key>GEO_AGENT_BETA_DAILY_MODEL_CALLS</key><string>@@DAILY_MODEL_CALLS@@</string>
    <key>GEO_AGENT_BETA_BUDGET_LEDGER_PATH</key><string>@@MODEL_BUDGET_LEDGER@@</string>
    <key>GEO_AGENT_BETA_BUDGET_BATCH_ID</key><string>@@MODEL_BUDGET_BATCH_ID@@</string>
    <key>GEO_AGENT_BETA_BUDGET_PRICING_CHECKED_AT</key><string>@@MODEL_PRICING_DATE@@</string>
    <key>GEO_BETA_SCHEDULED_SAMPLING_ENABLED</key><string>@@SCHEDULED_SAMPLING@@</string>
    <key>WENXIN_PROFILE_DIR</key><string>@@WENXIN_PROFILE_DIR@@</string>
    <key>WENXIN_MAX_CONCURRENCY</key><string>1</string>
    <key>WENXIN_MAX_RETRIES</key><string>0</string>
  </dict>
  <key>RunAtLoad</key><true/><key>KeepAlive</key><true/>
  <key>ProcessType</key><string>Background</string>
  <key>StandardOutPath</key><string>@@LOG_PATH@@</string>
  <key>StandardErrorPath</key><string>@@LOG_PATH@@</string>
  <key>ThrottleInterval</key><integer>5</integer>
</dict></plist>
